        "import torch\n",
        "import torchvision\n",
        "\n",
        "# Defined a wrapper model to return only segmentation logits\n",
        "class M(torch.nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.model = torchvision.models.segmentation.deeplabv3_resnet50(\n",
        "            weights=\"DEFAULT\"\n",
        "        ).eval()\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.model(x)[\"out\"]\n",
        "\n",
        "\n",
        "# Initialized the model and prepared a dummy input\n",
        "model = M().eval()\n",
        "dummy = torch.randn(1, 3, 520, 520)\n",
        "\n",
        "# Exported the model to ONNX format\n",
        "torch.onnx.export(\n",
        "    model,\n",
        "    dummy,\n",
        "    \"deeplabv3_logits.onnx\",\n",
        "    opset_version=17,\n",
        "    input_names=[\"input\"],\n",
        "    output_names=[\"logits\"],\n",
        ")\n",
        "\n",
        "print(\"Saved deeplabv3_logits.onnx\")"
