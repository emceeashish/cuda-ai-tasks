        "import torch\n",
        "from torch.utils.cpp_extension import load_inline\n",
        "\n",
        "# Verified that CUDA was available before building the extension\n",
        "assert torch.cuda.is_available()\n",
        "\n",
        "# Defined the C++ interface for the CUDA extension\n",
        "cpp_src = r\"\"\"\n",
        "#include <torch/extension.h>\n",
        "#include <vector>\n",
        "\n",
        "std::vector<torch::Tensor> seg_apply_cuda(torch::Tensor logits,\n",
        "                                         torch::Tensor img,\n",
        "                                         int64_t target);\n",
        "\n",
        "std::vector<torch::Tensor> seg_apply(torch::Tensor logits,\n",
        "                                     torch::Tensor img,\n",
        "                                     int64_t target) {\n",
        "    return seg_apply_cuda(logits, img, target);\n",
        "}\n",
        "\n",
        "PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n",
        "    m.def(\"seg_apply\", &seg_apply, \"seg_apply\");\n",
        "}\n",
        "\"\"\"\n",
        "\n",
        "# Implemented the CUDA kernel for argmax and mask application\n",
        "cuda_src = r\"\"\"\n",
        "#include <torch/extension.h>\n",
        "#include <cuda.h>\n",
        "#include <cuda_runtime.h>\n",
        "#include <vector>\n",
        "\n",
        "__global__ void k(const float* logits,\n",
        "                  const unsigned char* img,\n",
        "                  unsigned char* out,\n",
        "                  unsigned char* mask,\n",
        "                  int C, int H, int W, int target) {\n",
        "    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n",
        "    int HW = H * W;\n",
        "    if (idx >= HW) return;\n",
        "\n",
        "    int best = 0;\n",
        "    float bestv = logits[idx];\n",
        "    for (int c = 1; c < C; ++c) {\n",
        "        float v = logits[c * HW + idx];\n",
        "        if (v > bestv) {\n",
        "            bestv = v;\n",
        "            best = c;\n",
        "        }\n",
        "    }\n",
        "\n",
        "    mask[idx] = (unsigned char)best;\n",
        "\n",
        "    int keep = (best == target);\n",
        "    int p = idx * 3;\n",
        "    out[p + 0] = keep ? img[p + 0] : 0;\n",
        "    out[p + 1] = keep ? img[p + 1] : 0;\n",
        "    out[p + 2] = keep ? img[p + 2] : 0;\n",
        "}\n",
        "\n",
        "std::vector<torch::Tensor> seg_apply_cuda(torch::Tensor logits,\n",
        "                                          torch::Tensor img,\n",
        "                                          int64_t target) {\n",
        "    int C = (int)logits.size(1);\n",
        "    int H = (int)logits.size(2);\n",
        "    int W = (int)logits.size(3);\n",
        "\n",
        "    auto out = torch::empty(\n",
        "        {H, W, 3},\n",
        "        torch::TensorOptions().dtype(torch::kUInt8).device(logits.device())\n",
        "    );\n",
        "\n",
        "    auto mask = torch::empty(\n",
        "        {H, W},\n",
        "        torch::TensorOptions().dtype(torch::kUInt8).device(logits.device())\n",
        "    );\n",
        "\n",
        "    int HW = H * W;\n",
        "    int threads = 256;\n",
        "    int blocks = (HW + threads - 1) / threads;\n",
        "\n",
        "    k<<<blocks, threads>>>(\n",
        "        logits.data_ptr<float>(),\n",
        "        img.data_ptr<unsigned char>(),\n",
        "        out.data_ptr<unsigned char>(),\n",
        "        mask.data_ptr<unsigned char>(),\n",
        "        C, H, W, (int)target\n",
        "    );\n",
        "\n",
        "    return {out, mask};\n",
        "}\n",
        "\"\"\"\n",
        "\n",
        "# Built the CUDA extension inline\n",
        "ext = load_inline(\n",
        "    name=\"seg_ext_min\",\n",
        "    cpp_sources=cpp_src,\n",
        "    cuda_sources=cuda_src,\n",
        "    functions=None,\n",
        "    with_cuda=True,\n",
        "    extra_cflags=[\"-O2\"],\n",
        "    extra_cuda_cflags=[\"-O2\"],\n",
        "    verbose=True,\n",
        ")\n",
        "\n",
        "print(\"built\")\n"
