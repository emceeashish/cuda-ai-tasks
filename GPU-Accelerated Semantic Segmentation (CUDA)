        "import numpy as np\n",
        "from PIL import Image\n",
        "\n",
        "# Defined the target class id\n",
        "TARGET = 15\n",
        "\n",
        "# Loaded the same resized image for CPU reference\n",
        "image = Image.open(\"img.jpeg\").convert(\"RGB\").resize((520, 520))\n",
        "image_u8 = np.array(image, dtype=np.uint8)\n",
        "\n",
        "# Computed the reference mask on CPU using argmax\n",
        "ref_mask = logits[0].argmax(axis=0).astype(np.uint8)\n",
        "\n",
        "# Applied the reference mask to the image\n",
        "ref_out = image_u8.copy()\n",
        "ref_out[ref_mask != TARGET] = 0\n",
        "\n",
        "# Loaded the CUDA-generated outputs\n",
        "cuda_out = np.array(Image.open(\"masked.png\"))\n",
        "cuda_mask = np.array(Image.open(\"mask_ids.png\"))\n",
        "\n",
        "# Compared CPU and CUDA results for correctness\n",
        "print(\"mask equal:\", np.array_equal(ref_mask, cuda_mask))\n",
        "print(\"out equal :\", np.array_equal(ref_out, cuda_out))\n"
