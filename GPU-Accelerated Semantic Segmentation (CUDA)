        "import numpy as np\n",
        "from PIL import Image\n",
        "import onnxruntime as ort\n",
        "\n",
        "# Created an ONNX Runtime session with GPU support\n",
        "sess = ort.InferenceSession(\n",
        "    \"deeplabv3_logits.onnx\",\n",
        "    providers=[\"CUDAExecutionProvider\", \"CPUExecutionProvider\"]\n",
        ")\n",
        "\n",
        "input_name = sess.get_inputs()[0].name\n",
        "\n",
        "# Loaded and resized the input image\n",
        "image = Image.open(\"img.jpeg\").convert(\"RGB\").resize((520, 520))\n",
        "\n",
        "# Preprocessed the image and applied normalization\n",
        "x = np.array(image, dtype=np.float32) / 255.0\n",
        "x = x.transpose(2, 0, 1)\n",
        "\n",
        "mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)[:, None, None]\n",
        "std = np.array([0.229, 0.224, 0.225], dtype=np.float32)[:, None, None]\n",
        "\n",
        "x = ((x - mean) / std)[None, ...]\n",
        "\n",
        "# Ran inference to obtain logits\n",
        "logits = sess.run(None, {input_name: x})[0]\n",
        "print(logits.shape, logits.dtype)\n"
      ],
